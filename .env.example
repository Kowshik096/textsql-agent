# Copy to .env and fill in. Everything here is optional - the agent runs
# without any of it.

# Langfuse tracing. Without a public key the instrumentation is a no-op:
# `traced` returns functions untouched, so there is no wrapper and no
# behavioural difference at all. Free tier at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# core = the 4-table configuration, for the schema-size ablation.
# Anything else loads all 7.
SCHEMA=full

# sample = the 1 MB committed fixture in data/sample, used by CI.
DATA_SOURCE=full

# 0 skips the prose answer call. Execution accuracy compares rows, not
# sentences, so benchmark runs are ~33% faster with it off.
ANSWER=1
