# Copy to .env and fill in. Everything here is optional - the agent runs
# without any of it.

# Langfuse tracing. Without a public key the instrumentation is a no-op:
# `traced` returns functions untouched, so there is no wrapper and no
# behavioural difference at all. Free tier at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# core = the 4-table configuration, for the schema-size ablation.
# Anything else loads all 7.
SCHEMA=full

# sample = the 1 MB committed fixture in data/sample, used by CI.
DATA_SOURCE=full

# 0 skips the prose answer call. Execution accuracy compares rows, not
# sentences, so benchmark runs are ~33% faster with it off.
ANSWER=1

# API hardening — all three are opt-in, so local dev needs no secret.
# API_TOKEN: Bearer token required on /query, /query/stream, /chat.
# API_TOKEN=s3cr3t
# RATE_LIMIT: sliding window per IP, e.g. "30/minute", "5/second".
# RATE_LIMIT=30/minute
# CACHE_TTL: cache identical /query questions for N seconds (0 disables).
# CACHE_TTL=300
# CACHE_MAX_SIZE: max cached questions (LRU eviction).
# CACHE_MAX_SIZE=128

# Hosted providers (offline only: hosted comparison run, answer-quality judge).
# The live agent never calls these - the request path stays fully local.
# GEMINI_API_KEY=      # free tier works; used by the judge by default
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Answer-quality judge: grades prose against result rows (never the SQL).
# Run the benchmark with --judge to activate; unset = judge never executes.
# JUDGE_MODEL=gemini-2.5-flash-lite
# JUDGE_PROVIDER=gemini
