# --- virtualenv ---
sqlagent_env/

# --- data (~73 MB) ---------------------------------------------------------
# The Olist CSVs and the built SQLite file stay out of history. Once a blob is
# committed it is in the pack forever, even if deleted later. Rebuild with:
#     python src/db.py
# See data/README.md for where to get the CSVs.
data/*.csv
data/*.db
!data/README.md

# --- private notes (not deliverables) ---
BUILD_LOG.md
LEARNING_PHASES.md

# --- eval cache (Day 3: per-case results so an interrupted run resumes) ---
.eval_cache/

# --- secrets ---
.env

# --- python ---
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# --- os / editor ---
Thumbs.db
.DS_Store
.vscode/

# --- generated charts ---
charts/

# --- eval run artefacts (derived; results.json/.txt are the record) ---
evals/.cache/
evals/.cache_var*/
evals/*.log
evals/logs/
evals/results_var*.json
evals/results_var*.txt

# --- external benchmark payloads (Spider; fetched, not authored) ----------
# The generated yaml files ARE committed evidence; the 200 MB dataset and
# extracted databases are reproducible via evals/fetch_spider.py:
#     python evals/fetch_spider.py
# (spider.zip, or the manual download it documents, provides dev.json plus
# the per-database sqlite files - including multi-hundred-MB ones GitHub
# refuses. Keep them local; never commit them.)
evals/external/spider.zip
evals/external/_extract/
evals/external/spider/database/

# Langfuse exports. Trace data carries the questions asked and the model's
# answers, which is not repo content, and the files run to several MB.
*lf-events-export*.csv
langfuse-export*.csv

# Personal planning/draft docs, same treatment as BUILD_LOG.md and
# LEARNING_PHASES.md: useful locally, not something a code reviewer needs.
RESUME_BULLETS.md
NEXT_FIVE_DAYS.md
